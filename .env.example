# Copy this file to .env and put your own key in it.
OPENAI_API_KEY=

# Call monitoring: the n8n webhook that receives each finished call, and the
# value of its X-Lamsa-Token header. Leave the URL empty to turn it off.
LAMSA_N8N_WEBHOOK_URL=
LAMSA_N8N_WEBHOOK_TOKEN=
LAMSA_N8N_UNANSWERED_WEBHOOK_URL=
